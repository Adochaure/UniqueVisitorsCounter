{
  "name": "unique-visitor-counter",
  "version": "0.3.0",
  "description": "Privacy-first unique visitor counter SDK.",
  "license": "MIT",
  "homepage": "https://unique-visitors-counter.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adochaure/UniqueVisitorsCounter.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Adochaure/UniqueVisitorsCounter/issues"
  },
  "keywords": [
    "unique-visitor-counter",
    "visitor counter",
    "unique visitors",
    "visitor count",
    "website analytics",
    "privacy first",
    "javascript",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "bin": {
    "uvc": "./dist/cli.js"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "react": "^19.0.0"
  },
  "publishConfig": { "access": "public" }
}
